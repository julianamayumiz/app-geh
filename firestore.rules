rules_version = '2';

// Regras Firestore — App GEH
//
// Modelo de acesso baseado em papel (role):
// - SUPER ADMIN: e-mail hardcoded da Juliana — sempre passa, mesmo
//   sem doc em /usuarios. Resolve o bootstrap (primeiro acesso) e
//   garante que ela nunca fica trancada do lado de fora.
// - ADMIN: tem doc em /usuarios/{uid} com papel='admin' e ativo=true.
//   Faz qualquer coisa.
// - OPERADOR: doc em /usuarios/{uid} com papel='operador' e ativo=true.
//   Lê dados do evento e registra vendas.
// - CAIXA: doc em /usuarios/{uid} com papel='caixa' e ativo=true.
//   Recarrega saldo dos clientes (lendo o QR).
// - RECEPCAO: doc em /usuarios/{uid} com papel='recepcao' e ativo=true.
//   Confere convites antecipados, registra check-in e venda na porta.
// - QUALQUER OUTRO: bloqueado.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return logado() && request.auth.token.email == 'juliana.mayumi14@gmail.com';
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function temPerfilAtivo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().ativo == true;
    }
    function isAdmin() {
      return isSuperAdmin() || (temPerfilAtivo() && perfil().papel == 'admin');
    }
    function isOperador() {
      return isAdmin() || (temPerfilAtivo() && perfil().papel == 'operador');
    }
    function isCaixa() {
      return isAdmin() || (temPerfilAtivo() && perfil().papel == 'caixa');
    }
    function isRecepcao() {
      return isAdmin() || (temPerfilAtivo() && perfil().papel == 'recepcao');
    }
    // Qualquer membro da equipe (operador, caixa, recepcao ou admin) —
    // usado em leituras compartilhadas como /clientes, /config/eventoAtivo.
    function isEquipe() {
      return isAdmin() || isOperador() || isCaixa() || isRecepcao();
    }

    // /usuarios — gerenciamento de acesso.
    // Cada um lê o próprio doc (pro auth-guard funcionar).
    // Listar e escrever, só admin.
    match /usuarios/{uid} {
      allow get: if isAdmin() || (logado() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /produtos/{doc} {
      allow read: if isOperador();
      allow update: if isOperador();
      allow create, delete: if isAdmin();
    }

    match /clientes/{doc} {
      allow read: if isEquipe();
      allow update: if isEquipe();
      allow create, delete: if isAdmin();
    }

    match /vendas/{doc} {
      allow read, create: if isOperador();
      allow update, delete: if isAdmin();
    }

    match /movimentacoes_saldo/{doc} {
      // Read aberto a toda equipe (operador consulta histórico do cliente).
      allow read: if isEquipe();
      // Create só pelo Caixa — recargas no fluxo normal.
      allow create: if isCaixa();
      allow update, delete: if isAdmin();
    }

    match /eventos/{doc} {
      allow read: if isEquipe();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isRecepcao()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['categoriasIngresso'])
        );
    }

    match /config/{doc} {
      allow read: if isEquipe();
      allow write: if isAdmin();
    }

    match /compras/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /despesas/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /insumos/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Ajustes manuais de saldo feitos pela Diretoria — auditoria
    // separada das recargas do Caixa. Imutavel: nao permite update
    // nem delete (nem para admin) pra preservar a trilha.
    match /ajustes_saldo/{doc} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Transferencias de saldo entre clientes (ex: familia juntando
    // QRs pra fazer uma compra). Caixa e operador podem criar pra
    // agilizar no balcao; recepcao nao mexe em saldo. Imutavel pra
    // preservar a trilha — correcao depois sai por ajuste-saldo.
    match /transferencias_saldo/{doc} {
      allow read: if isEquipe();
      allow create: if isCaixa() || isOperador();
      allow update, delete: if false;
    }

    // Convites antecipados (lista de conferência da recepção):
    // importados em lote via Excel. Recepção lê, busca e marca check-in
    // (update do campo presente/checkInEm). Admin gerencia.
    match /convites_antecipados/{doc} {
      allow read: if isRecepcao();
      allow update: if isRecepcao();
      allow create, delete: if isAdmin();
    }

    // Vendas na porta — convites criados na hora pela recepção.
    // Histórico imutável (só admin pode corrigir/excluir).
    match /vendas_porta/{doc} {
      allow read, create: if isRecepcao();
      allow update, delete: if isAdmin();
    }
  }
}
