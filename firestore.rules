rules_version = '2';

// Regras Firestore — App GEH
//
// Modelo de acesso baseado em papel (role):
// - SUPER ADMIN: e-mail hardcoded da Juliana — sempre passa, mesmo
//   sem doc em /usuarios. Resolve o bootstrap (primeiro acesso).
// - ADMIN: tem doc em /usuarios/{uid} com papel='admin' e ativo=true.
//   Faz qualquer coisa.
// - OPERADOR: tem doc em /usuarios/{uid} com papel='operador' e
//   ativo=true. Pode ler dados do evento e registrar vendas/recargas.
// - QUALQUER OUTRO: bloqueado.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────
    function logado() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return logado() && request.auth.token.email == 'juliana.mayumi14@gmail.com';
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function temPerfilAtivo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().ativo == true;
    }
    function isAdmin() {
      return isSuperAdmin() || (temPerfilAtivo() && perfil().papel == 'admin');
    }
    function isOperador() {
      return isAdmin() || (temPerfilAtivo() && perfil().papel == 'operador');
    }

    // ── /usuarios — gerenciamento de acesso ──────────────────────────
    // Só admin lê e escreve. Cada um pode ler o próprio doc (pro
    // auth-guard funcionar sem precisar ser admin).
    match /usuarios/{uid} {
      allow get: if isAdmin() || (logado() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Dados do evento ──────────────────────────────────────────────
    // Operador lê tudo e escreve nas operações da venda.
    // Admin tem acesso total.

    match /produtos/{doc} {
      allow read: if isOperador();
      allow update: if isOperador();
      allow create, delete: if isAdmin();
    }

    match /clientes/{doc} {
      allow read: if isOperador();
      allow update: if isOperador();
      allow create, delete: if isAdmin();
    }

    match /vendas/{doc} {
      allow read, create: if isOperador();
      allow update, delete: if isAdmin();
    }

    match /movimentacoes_saldo/{doc} {
      allow read, create: if isOperador();
      allow update, delete: if isAdmin();
    }

    match /eventos/{doc} {
      allow read: if isOperador();
      allow write: if isAdmin();
    }

    match /config/{doc} {
      allow read: if isOperador();
      allow write: if isAdmin();
    }

    match /compras/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
