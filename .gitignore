.claude/worktrees/
.firebase/

# Backup do Firestore — chave de servico e arquivos gerados
dev-tools/backup/service-account.json
dev-tools/backup/backups/
dev-tools/backup/node_modules/

# Testes das firestore.rules — dependencias de dev, nao vai pro repo
dev-tools/rules-tests/node_modules/

# Cloud Functions — dependencias, nao vai pro repo
functions/node_modules/
# Log do emulador — sobra onde o comando for rodado (raiz ou dev-tools/rules-tests)
firestore-debug.log

# Defesa adicional: qualquer arquivo .env, chave privada ou service account
# que acabe em dev-tools/ (fora do /backup ja coberto acima) tambem nao vai.
dev-tools/**/*.env
dev-tools/**/*service-account*.json
dev-tools/**/*-key.json

# PoC temporaria de leitura de QR (libs vendorizadas, nao entra no repo)
dev-tools/poc-qr/

# Logs de debug do Firebase CLI e bytecode Python
*.log
__pycache__/

# Teste de carga: config com credenciais de dev e resultados das rodadas
dev-tools/load-test/config.dev.json
dev-tools/load-test/results-*.json
dev-tools/load-test/node_modules/
